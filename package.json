{
  "name": "fullhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Full House: the agent that fills a small venue's quiet night, every week. Built on Qloo's taste graph.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "build": "vite build --config web/vite.config.ts",
    "dev": "bash scripts/dev.sh",
    "e2e": "bash scripts/e2e.sh",
    "probe": "node --no-warnings --experimental-strip-types scripts/probe/index.ts",
    "live-read": "node --no-warnings --experimental-strip-types scripts/live/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "hono": "4.12.5",
    "leaflet": "1.9.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  }
}
